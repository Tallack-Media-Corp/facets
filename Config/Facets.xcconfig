// Shared build settings. Anything tied to an Apple developer account lives in
// Local.xcconfig, which is git-ignored. Copy Local.example.xcconfig to start one.

// Bundle id of the app; the extensions append .preview and .thumbnail.
FACETS_BUNDLE_ID = com.example.facets

// Leave empty to build for the simulator without signing in.
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
