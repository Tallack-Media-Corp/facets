    "Add Location… at the foot of the sidebar lets you look through a folder's models where they are, and save the ones you want.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Ort hinzufügen …“ unten in der Seitenleiste kannst du die Modelle eines Ordners dort ansehen, wo sie liegen, und die gewünschten sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con “Añadir ubicación…”, al pie de la barra lateral, puedes ver los modelos de una carpeta donde están y guardar los que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ajouter un emplacement… », en bas de la barre latérale, vous permet de parcourir les modèles d'un dossier là où ils se trouvent et d'enregistrer ceux que vous voulez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバー下部の“場所を追加…”を使うと、フォルダ内のモデルをその場で閲覧し、必要なものを保存できます。"
          }
        }
      }
    },
    "Add Models": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir modelos"
          }
        },
        "fr": {
