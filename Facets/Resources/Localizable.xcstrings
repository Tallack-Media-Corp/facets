            "state": "translated",
            "value": "Ajouter des modèles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを追加"
          }
        }
      }
    },
    "Add a folder from Files to look through its models where they are, and save the ones you want.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ordner aus „Dateien“ hinzu, um seine Modelle dort anzusehen, wo sie liegen, und die gewünschten zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta de Archivos para ver sus modelos donde están y guardar los que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier depuis Fichiers pour parcourir ses modèles là où ils se trouvent et enregistrer ceux que vous voulez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ファイル”からフォルダを追加すると、モデルをその場で閲覧し、必要なものを保存できます。"
          }
        }
      }
    },
    "Add a folder from iCloud Drive, On My iPhone or any storage app in Files to browse its STL, 3MF and OBJ files here. Facets can only see folders you choose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ordner aus iCloud Drive, „Auf meinem iPhone“ oder einer anderen Speicher-App in „Dateien“ hinzu, um seine STL-, 3MF- und OBJ-Dateien hier zu durchsuchen. Facets sieht nur Ordner, die du auswählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta de iCloud Drive, En mi iPhone o cualquier app de almacenamiento de Archivos para explorar aquí sus archivos STL, 3MF y OBJ. Facets solo puede ver las carpetas que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier d'iCloud Drive, de « Sur mon iPhone » ou de toute app de stockage dans Fichiers pour parcourir ici ses fichiers STL, 3MF et OBJ. Facets ne voit que les dossiers que vous choisissez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ファイル”のiCloud Drive、“このiPhone内”、またはほかのストレージAppからフォルダを追加すると、そのSTL、3MF、OBJファイルをここでブラウズできます。Facetsが参照できるのは選択したフォルダだけです。"
          }
        }
      }
    },
