    },
    "A quarter turn, front edge down": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vierteldrehung, Vorderkante nach unten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cuarto de vuelta hacia delante"
          }
        },
        "fr": {
