    "%@ was moved, renamed or deleted, or Facets no longer has access to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde bewegt, umbenannt oder gelöscht, oder Facets hat keinen Zugriff mehr darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha movido, renombrado o eliminado, o Facets ya no tiene acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a été déplacé, renommé ou supprimé, ou Facets n'y a plus accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は移動、名称変更、または削除されたか、Facetsからアクセスできなくなりました。"
          }
        }
      }
    },
