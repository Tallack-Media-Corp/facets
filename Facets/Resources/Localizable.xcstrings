    "Models and folders you delete stay here for 30 days, so you can put them back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Modelle und Ordner bleiben 30 Tage hier, damit du sie zurücklegen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos y carpetas que elimines se quedan aquí 30 días para que puedas recuperarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles et dossiers que vous supprimez restent ici pendant 30 jours, pour que vous puissiez les remettre en place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したモデルやフォルダは30日間ここに残るので、元に戻すことができます。"
          }
        }
