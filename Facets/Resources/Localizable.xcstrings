    "#3DBenchy by Creative Tools (3DBenchy.com), public domain (CC0). The two-colour version is made from its dual-print files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "#3DBenchy von Creative Tools (3DBenchy.com), gemeinfrei (CC0). Die zweifarbige Version entsteht aus den Dateien für den Zweifarbdruck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "#3DBenchy de Creative Tools (3DBenchy.com), de dominio público (CC0). La versión de dos colores se ha hecho a partir de sus archivos de impresión doble."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "#3DBenchy par Creative Tools (3DBenchy.com), domaine public (CC0). La version bicolore provient de ses fichiers d'impression double."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#3DBenchy（Creative Tools作、3DBenchy.com）、パブリックドメイン（CC0）。2色バージョンはデュアルプリント用ファイルから作成しています。"
          }
        }
      }
    },
