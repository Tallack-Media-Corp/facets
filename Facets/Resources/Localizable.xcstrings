    "Change how the library is shown and sorted. Double-click a model to open it; Space shows a quick look.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie die Bibliothek angezeigt und sortiert wird. Doppelklicke auf ein Modell, um es zu öffnen; die Leertaste zeigt eine Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia cómo se muestra y ordena la biblioteca. Haz doble clic en un modelo para abrirlo; la barra espaciadora muestra una vista rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
