    },
    "This model was moved, renamed or deleted, or Facets no longer has access to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell wurde bewegt, umbenannt oder gelöscht, oder Facets hat keinen Zugriff mehr darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo se ha movido, renombrado o eliminado, o Facets ya no tiene acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle a été déplacé, renommé ou supprimé, ou Facets n'y a plus accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルは移動、名称変更、または削除されたか、Facetsからアクセスできなくなりました。"
          }
        }
      }
    },
    "Thumbnails use %@. They're redrawn when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniaturen belegen %@. Sie werden bei Bedarf neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las miniaturas ocupan %@. Se vuelven a generar cuando hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vignettes occupent %@. Elles sont redessinées si nécessaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネールが%@を使用しています。サムネールは必要に応じて再作成されます。"
          }
        }
      }
    },
