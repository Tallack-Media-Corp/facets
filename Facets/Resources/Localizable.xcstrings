            "value": "Vuelve a tocar el modelo y levanta el dedo en el segundo punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez à nouveau le modèle et levez le doigt sur le second point."
          }
