    "3MF projects from Bambu Studio, Orca Slicer and others carry filament colours. STL files always use the model colour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3MF-Projekte aus Bambu Studio, Orca Slicer und anderen enthalten Filamentfarben. STL-Dateien verwenden immer die Modellfarbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos 3MF de Bambu Studio, Orca Slicer y otros incluyen los colores del filamento. Los archivos STL siempre usan el color del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets 3MF de Bambu Studio, Orca Slicer et d'autres contiennent les couleurs des filaments. Les fichiers STL utilisent toujours la couleur du modèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu StudioやOrca Slicerなどの3MFプロジェクトにはフィラメントの色が含まれています。STLファイルでは常にモデルカラーが使われます。"
          }
        }
      }
    },
    "A folder can't go inside itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner kann nicht in sich selbst liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta no puede ir dentro de sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier ne peut pas être placé dans lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダをそれ自身の中に入れることはできません。"
          }
        }
      }
    },
    "A quarter turn on the bed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vierteldrehung auf dem Druckbett"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cuarto de vuelta sobre la cama"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un quart de tour sur le plateau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベッド上で90°回転"
          }
        }
      }
    },
