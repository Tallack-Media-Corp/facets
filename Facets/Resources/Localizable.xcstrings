    "File Units": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einheiten der Datei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidades del archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unités du fichier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの単位"
          }
        }
      }
    },
    "File Units sets what one unit in the file means, for a model saved in metres, centimetres or inches. Facets remembers it for this file; the file itself isn't changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Einheiten der Datei“ legt fest, was eine Einheit in der Datei bedeutet, wenn ein Modell in Metern, Zentimetern oder Zoll gesichert wurde. Facets merkt sich das für diese Datei; die Datei selbst bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Unidades del archivo” define qué significa una unidad del archivo, para modelos guardados en metros, centímetros o pulgadas. Facets lo recuerda para este archivo; el archivo en sí no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Unités du fichier » définit ce que vaut une unité du fichier, pour un modèle enregistré en mètres, centimètres ou pouces. Facets s'en souvient pour ce fichier ; le fichier lui-même n'est pas modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ファイルの単位”では、メートル、センチメートル、インチで保存されたモデルについて、ファイル内の1単位が何を表すかを設定します。Facetsはこのファイルの設定を記憶します。ファイル自体は変更されません。"
          }
        }
      }
    },
    "Find STL, 3MF and OBJ files by name, in every folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde STL-, 3MF- und OBJ-Dateien nach Namen, in allen Ordnern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca archivos STL, 3MF y OBJ por nombre en todas las carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez les fichiers STL, 3MF et OBJ par nom, dans tous les dossiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのフォルダからSTL、3MF、OBJファイルを名前で検索します。"
          }
        }
      }
    },
